    "react": "18.3.1",
    "react-dom": "18.3.1",
    "y-prosemirror": "1.2.13",
    "y-websocket": "2.0.4",
    "yjs": "13.6.20"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.4.4",
